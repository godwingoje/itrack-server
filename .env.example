# Application
PORT=3000
NODE_ENV=development
# Comma-separated exact browser origins for deployed clients. Loopback origins
# (localhost, 127.0.0.1, and ::1 on any port) are always allowed for development.
CORS_ORIGINS=

# Data source selection: "memory" or "prisma"
# When set to "memory", the application runs with in-memory seeded demo users and requires no database.
DATA_SOURCE=memory

# Seed password for in-memory demo users (hashed at startup with bcrypt cost 12)
SEED_PASSWORD=password123

# JWT Configuration
JWT_SECRET=replace-with-a-secure-secret-key-at-least-32-characters-long
JWT_EXPIRES_IN=15m

# Database (used only when DATA_SOURCE=prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fixflow_db?schema=public
