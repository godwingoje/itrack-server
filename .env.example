# Application
PORT=3000
NODE_ENV=development
# Comma-separated exact browser origins for deployed clients. Loopback origins
# (localhost, 127.0.0.1, and ::1 on any port) are always allowed for development.
CORS_ORIGINS=http://localhost:5173

# Cookie settings. Production frontend and API deployments on different sites
# require SameSite=None and Secure=true so HTTP-only session cookies can be
# sent with cross-origin API calls.
COOKIE_SAME_SITE=none
COOKIE_SECURE=true

# JWT Configuration
JWT_SECRET=replace-with-a-secure-secret-key-at-least-32-characters-long
JWT_EXPIRES_IN=15m

# Database. Use the pooled URL for app traffic; use DATABASE_URL_UNPOOLED only for schema tools.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Set unique passwords (at least 12 characters) in the ignored local .env before seeding.
DEMO_ADMIN_PASSWORD=
DEMO_TECHNICIAN_PASSWORD=
DEMO_EMPLOYEE_PASSWORD=
